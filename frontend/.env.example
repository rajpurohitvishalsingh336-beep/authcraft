# AuthCraft Frontend Environment Variables for Vercel

# Public URL of the FastAPI Backend
# For local development: http://localhost:8000/api/v1
# For production: https://your-backend-api.com/api/v1 (or your production backend URL)
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Internal server rewrite URL (used by Next.js rewrites in next.config.js)
INTERNAL_API_URL=http://127.0.0.1:8000/api/v1
