# ==============================================================================
# AUTHCRAFT ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and adjust values for your environment.
# Never commit active secrets or credentials to source control.
# ==============================================================================

# Application Environment
ENVIRONMENT=development
DEBUG=True
APP_NAME=AuthCraft

# Cryptographic Secret (Must be at least 32 characters long in production)
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-this-in-production-to-a-very-secure-random-string-at-least-32-chars

# Database Configuration
# Local SQLite development default:
DATABASE_URL=sqlite:///./authcraft.db
# PostgreSQL Docker default:
# DATABASE_URL=postgresql://authcraft_user:authcraft_secure_password@localhost:5432/authcraft_db

# Postgres Credentials (Used by Docker Compose)
POSTGRES_USER=authcraft_user
POSTGRES_PASSWORD=authcraft_secure_password
POSTGRES_DB=authcraft_db

# Frontend and Hosted Login URLs
FRONTEND_URL=http://localhost:3000
PUBLIC_HOSTED_DOMAIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Security & Cookies
COOKIE_SECURE=False  # Set to True when served over HTTPS
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=

# Development Email Mode (Captures outbound emails into memory/outbox endpoint)
DEV_EMAIL_MODE=True

# Rate Limiting
RATE_LIMIT_LOGIN=10/minute
RATE_LIMIT_REGISTER=10/minute
